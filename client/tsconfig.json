{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@citylens/shared": ["shared/schema.ts"],
      "@citylens/shared/*": ["shared/*"]
    }
  },
  "include": ["src", "../shared/**/*.ts", "vite.config.ts"]
}
