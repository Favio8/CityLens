# CityLens 读城 环境变量示例
# 复制为 .env 后按需填写。所有密钥只在服务端读取，绝不进入前端构建产物。

# 服务端口（前端 dev server 通过 Vite 代理访问）
PORT=8787

# 大模型：默认 DeepSeek（OpenAI 兼容接口）
# 未配置 LLM_API_KEY 时，服务端自动启用模拟 LLM（仅用于开发自测），
# 并在所有生成入口标注“模拟生成”。
# 填好 Key 后重启服务即可切换到真实生成；也可以在 /admin 页面运行时配置，
# 支持 DeepSeek、阶跃星辰 StepFun（https://api.stepfun.com/v1）与任意兼容接口。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# 强制使用模拟 LLM（即使配置了真实 Key）；未配置 Key 时自动开启
MOCK_LLM=

# 天地图 Key（浏览器端瓦片请求必需，按域名白名单限制的公开 Key）
# 申请地址：https://cloudcenter.tianditu.gov.cn/ （开发管理 → 应用管理），类型选择「浏览器端」。
# 填写后重启服务，前端会自动加载 t0-t7 的矢量底图与注记；
# 未配置时不加载底图瓦片，仅绘制行政区轮廓与宣纸底色。
TIANDITU_KEY=
# 服务端天地图 Key（可选）：只用于服务端地名检索，不下发浏览器。
# 也可以在 /admin 页面运行时配置浏览器端与服务端 Key。
TIANDITU_SERVER_KEY=

# 联网检索（Tavily）：非预置城市首次生成时检索维基百科、统计公报与民俗线索。
# 免费额度约 1,000 次/月；未配置时仍会使用 Wikipedia / Wikidata / Open-Meteo 等免费源。
# 申请地址：https://app.tavily.com/ ；也可以直接在 /admin → 联网检索 中配置。
TAVILY_API_KEY=
# 每日检索请求上限（每次城市侦察通常消耗 2 次）
SEARCH_DAILY_LIMIT=200

# 维基百科访问代理（可选）：Node 不会自动读取系统代理；
# 需要时在启动服务的 shell 中设置 HTTPS_PROXY/HTTP_PROXY，例如 http://127.0.0.1:7890。

# 后台管理（/admin）与预置城市强制重新生成所需的管理令牌
# 为空时后台配置仅允许本机回环访问；公网部署必须设置。
ADMIN_TOKEN=

# 生产环境允许的跨域来源（逗号分隔，须带协议，如 https://citylens.example.com）
# 开发环境额外放行 http://localhost:* 与 http://127.0.0.1:*；同源请求不受影响。
APP_ORIGINS=

# 每日大模型调用预算
LLM_DAILY_CALL_LIMIT=500

# 是否在档案中使用已下载到本地的 Wikimedia Commons 图片
# 先运行 npm run data:images；开启后运行期仍不请求外部图片。
ENABLE_IMAGES=false

# IP 加盐哈希所用的盐（生产环境务必修改）
IP_HASH_SALT=citylens-dev-salt

# 开发自测：模拟指定模块失败，逗号分隔，例如 poetics 或 poetics,figures
SIMULATE_FAIL=

# 模拟 LLM 的单模块延迟（毫秒），用于验证流式时序；未设置时使用默认值
MOCK_LLM_DELAY_MS=

# ------------------------------------------------------------------
# 构建期数据抓取（仅 npm run data:* 使用，不影响服务端运行）
# ------------------------------------------------------------------
# 可选：GitHub 公开仓库只读 Token，提高 chinese-poetry 目录接口限额
GITHUB_TOKEN=
# 设为 1 强制忽略本地缓存并重新联网抓取
REFRESH_WIKIDATA=
REFRESH_POETRY=
REFRESH_IMAGES=
